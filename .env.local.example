# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.
# The app runs without these (offline mock provider); the Gemini key unlocks the
# live Gemini Live voice/text session plus image generation and vision pre-reads.

# Google Gemini API key — required for live voice (ephemeral Live API tokens are
# minted server-side, ADR-0013) AND for generate_image / image pre-reads. Used
# server-side only. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional — Gemini Live model + voice; sensible defaults in code. These are
# DEVELOPER-API ids (the Vertex names differ); list what your key can use with
# GET /v1beta/models and filter for bidiGenerateContent. Alternatives:
# gemini-2.5-flash-native-audio-preview-12-2025 (pinned) or
# gemini-3.1-flash-live-preview (newer generation) if tool calling misbehaves (LL-014).
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# Prebuilt voice name (Aoede, Puck, Charon, Kore, Fenrir, Leda, Orus, Zephyr, …)
# GEMINI_LIVE_VOICE=Aoede

# Optional image model override. gemini-2.5-flash-image is "Nano Banana";
# gemini-3.1-flash-image ("Nano Banana 2") is newer/higher-fidelity.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Web search — unlocks the web_search tool (assistant looks things up live).
# Provide ONE: Tavily is preferred (returns an AI-ready answer + sources);
# Brave is the fallback (web results only). Used server-side only; omit both to
# disable the tool.
#   Tavily key: https://app.tavily.com  |  Brave key: https://api-dashboard.search.brave.com
TAVILY_API_KEY=your-tavily-api-key
# BRAVE_API_KEY=your-brave-api-key

# Website screenshots — unlocks the screenshot_website tool (assistant captures a
# live web page and drops it on the canvas via thum.io). Used server-side only;
# omit to disable the tool. Get a key at https://www.thum.io
THUM_IO_KEY=your-thum-io-key
