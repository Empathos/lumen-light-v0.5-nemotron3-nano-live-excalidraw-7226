# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.
# The app runs without these (offline mock provider); the OpenRouter key unlocks
# the Nemotron chat brain, the Gemini key unlocks image generation and the
# vision reads the text-only brain depends on (ADR-0014).

# OpenRouter API key — required for the Nemotron 3 Nano brain. Used server-side
# only. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional model override; default in code. Alternatives:
# nvidia/nemotron-3-nano-30b-a3b:free (free tier, tighter rate limits) or
# nvidia/nemotron-3-super-120b-a12b (bigger sibling) for A/B runs.
# NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Google Gemini API key — powers generate_image ("Nano Banana"), image pre-reads
# (LL-012), and the layout/vision reads that stand in for model sight (LL-013,
# ADR-0014). Strongly recommended. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional image model override. gemini-2.5-flash-image is "Nano Banana";
# gemini-3.1-flash-image ("Nano Banana 2") is newer/higher-fidelity.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Web search — unlocks the web_search tool (assistant looks things up live).
# Provide ONE: Tavily is preferred (returns an AI-ready answer + sources);
# Brave is the fallback (web results only). Used server-side only; omit both to
# disable the tool.
#   Tavily key: https://app.tavily.com  |  Brave key: https://api-dashboard.search.brave.com
TAVILY_API_KEY=your-tavily-api-key
# BRAVE_API_KEY=your-brave-api-key

# Website screenshots — unlocks the screenshot_website tool (assistant captures a
# live web page and drops it on the canvas via thum.io). Used server-side only;
# omit to disable the tool. Get a key at https://www.thum.io
THUM_IO_KEY=your-thum-io-key
